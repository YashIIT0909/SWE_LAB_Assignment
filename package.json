{
  "name": "sccs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @sccs/api & npm run dev -w @sccs/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @sccs/web",
    "build": "npm run build --workspaces --if-present",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
